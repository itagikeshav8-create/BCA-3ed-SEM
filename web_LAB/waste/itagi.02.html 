<html>
<head>
    <title>Lists Demonstration</title>
</head>

<body>

<h1>Lists Demonstration</h1>

<h3>Unordered List</h3>

<ul>
    <li>BCA</li>
    <li>BCom</li>
    <li>BSC</li>
    <li>BBA</li>
</ul>

<ul style="list-style-type:square">
    <li>BCA</li>
    <li>BCom</li>
    <li>BSC</li>
    <li>BBA</li>
</ul>

<ul style="list-style-type:circle">
    <li>BCA</li>
    <li>BCom</li>
    <li>BSC</li>
    <li>BBA</li>
</ul>

<h3>Ordered List</h3>

<ol>
    <li>BCA</li>
    <li>BCom</li>
    <li>BSC</li>
    <li>BBA</li>
</ol>

<ol type="a">
    <li>BCA</li>
    <li>BCom</li>
    <li>BSC</li>
    <li>BBA</li>
</ol>

<ol type="i">
    <li>BCA</li>
    <li>BCom</li>
    <li>BSC</li>
    <li>BBA</li>
</ol>

<ol type="I">
    <li>BCA</li>
    <li>BCom</li>
    <li>BSC</li>
    <li>BBA</li>
</ol>

<h3>Description List</h3>

<dl>
    <dt><b>BCA</b></dt>
    <dd>Bachelor of Computer Application</dd>

    <dt><b>BBA</b></dt>
    <dd>Business Administration Management</dd>
</dl>

</body>
</html>